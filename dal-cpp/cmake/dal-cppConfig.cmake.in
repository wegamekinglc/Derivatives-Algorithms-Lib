@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(DAL_CPP_AAD_BACKEND "@DAL_CPP_AAD_BACKEND@")
set(DAL_CPP_MSVC_RUNTIME_LIBRARY "@DAL_CPP_MSVC_RUNTIME_LIBRARY@")

function(dal_cpp_apply_msvc_runtime target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "dal_cpp_apply_msvc_runtime: target '${target}' does not exist")
    endif()

    if(MSVC)
        if(NOT DAL_CPP_MSVC_RUNTIME_LIBRARY)
            message(FATAL_ERROR "installed dal-cpp package does not declare its MSVC runtime library")
        endif()
        set_property(TARGET "${target}" PROPERTY
            MSVC_RUNTIME_LIBRARY "${DAL_CPP_MSVC_RUNTIME_LIBRARY}")
    endif()
endfunction()

if(DAL_CPP_AAD_BACKEND STREQUAL "XAD")
    find_dependency(XAD CONFIG)
elseif(DAL_CPP_AAD_BACKEND STREQUAL "CoDiPack")
    include("${CMAKE_CURRENT_LIST_DIR}/DALCoDiPackTargets.cmake")
elseif(DAL_CPP_AAD_BACKEND STREQUAL "Adept")
    include("${CMAKE_CURRENT_LIST_DIR}/DALAdeptTargets.cmake")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dal-cppTargets.cmake")
check_required_components(dal-cpp)
